# Copy to .env and replace placeholders with your own keys. Never commit .env.

# VirusTotal v3 — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY

# Slack Incoming Webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# HTTP / TI clients
REQUEST_TIMEOUT_SECONDS=15
API_MAX_RETRIES=4
API_RETRY_BACKOFF_BASE_SECONDS=0.75
API_RETRY_BACKOFF_MAX_SECONDS=30

# Slack POST timeout
SLACK_WEBHOOK_TIMEOUT_SECONDS=10

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
